generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String           @id @default(uuid())
  fullName            String
  email               String           @unique
  passwordHash        String
  role                Role             @default(USER)
  referralCode        String           @unique
  sessionVersion      Int              @default(0)
  balance             Decimal          @default(0) @db.Decimal(12, 2)
  // Demo/simulation-only ledger for the 45-product workbench — entirely
  // separate from `balance`, which is the real Wallet/crypto-deposit
  // balance. Workbench commission/price math reads and writes only this
  // field; the real Deposit/approval flow never touches it, and vice
  // versa. See order.service.ts.
  workbenchBalance    Decimal          @default(0) @db.Decimal(12, 2)
  totalEarnings       Decimal          @default(0) @db.Decimal(12, 2)
  totalDeposits       Decimal          @default(0) @db.Decimal(12, 2)
  completedOrders     Int              @default(0)
  mergeTriggered      Boolean          @default(false)
  // How many of the 3 fixed workbench Merged Product milestones (orders 10,
  // 20, 30 — see config/simulation.ts's MERGE_ORDER_MILESTONES) this user has
  // already triggered. Replaces the old single-shot mergeTriggered boolean
  // for gating (mergeTriggered itself is kept, still set true on the first
  // merge, for any existing reader relying on it as "has ever merged").
  mergedMilestonesReached Int          @default(0)
  isMerged            Boolean          @default(false)
  trainingCompletedAt DateTime?
  // Admin-granted tier override (pay-to-unlock flow): a customer can reach
  // a tier by depositing at least that tier's existing minDeposits amount
  // and having an admin confirm it here, as an alternative to the normal
  // automatic completedOrders+totalDeposits progression below — which is
  // untouched and still applies on its own. Effective tier is always the
  // higher-ranked of the two (see utils/tiers.ts's resolveEffectiveTier).
  // Never set directly from a client request.
  manualTier          Tier?
  manualTierGrantedAt DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  referralReceived    Referral?        @relation("ReferralReceived")
  referralsMade       Referral[]       @relation("ReferralsMade")
  taskSubmissions     TaskSubmission[]
  transactions        Transaction[]
  depositsMade        Deposit[]        @relation("DepositsMade")
  depositsReviewed    Deposit[]        @relation("DepositsReviewed")
  trainingProgress    UserTrainingProgress[]
  lessonCompletions   UserLessonCompletion[]

  trainingTaskSubmissions         TrainingTaskSubmission[] @relation("TrainingTaskSubmissionsByUser")
  trainingTaskSubmissionsReviewed TrainingTaskSubmission[] @relation("TrainingTaskSubmissionsReviewed")

  @@index([email])
}

model Product {
  id              String           @id @default(uuid())
  displayOrder    Int              @unique
  name            String
  category        String
  reward          Decimal          @db.Decimal(10, 2)
  cost            Decimal          @db.Decimal(10, 2)
  // Admin-set product value used for the workbench's commission math
  // (commission = price * 1%, or * 10% for a merged event) — see
  // order.service.ts. Independent of reward/cost, which predate the
  // workbench redesign and are no longer used to compute commission.
  // Defaults to 0: a product only appears in the customer workbench once
  // an admin gives it a real price via Product Management.
  price           Decimal          @default(0) @db.Decimal(12, 2)
  // Which customer tier's workbench band this product belongs to (see
  // utils/tiers.ts / order.service.ts's tier-banded workbench). Null means
  // "Bronze" — every product created before this field existed is treated
  // as Bronze-eligible so none of them silently disappear from the
  // workbench. Never trusted from a client; admin-set only.
  tierEligibility Tier?
  imageUrl        String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  taskSubmissions TaskSubmission[]

  @@index([isActive])
  @@index([tierEligibility])
}

model TaskSubmission {
  id           String   @id @default(uuid())
  userId       String
  productId    String
  rewardAmount Decimal  @db.Decimal(10, 2)
  costAmount   Decimal  @db.Decimal(10, 2)
  // True when this row was created as part of a merged event (see
  // evaluateMergeEvent in order.service.ts) — lets the Records page label
  // historical rows Normal vs Merged without re-deriving the event.
  isMergedOrder Boolean @default(false)
  createdAt    DateTime @default(now())
  product      Product  @relation(fields: [productId], references: [id])
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

model Transaction {
  id          String            @id @default(uuid())
  userId      String
  type        TransactionType
  amount      Decimal           @db.Decimal(12, 2)
  status      TransactionStatus @default(PENDING)
  description String
  createdAt   DateTime          @default(now())
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deposit     Deposit?

  @@index([userId, createdAt])
}

enum CryptoAssetCode {
  USDT
  BTC
  ETH
}

// Admin-configurable per-asset deposit settings. Fixed set of three assets
// (USDT/BTC/ETH) as scoped — not an open-ended asset catalog.
model CryptoAsset {
  id        String          @id @default(uuid())
  code      CryptoAssetCode @unique
  address   String?
  isEnabled Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deposits  Deposit[]

  @@index([isEnabled])
}

enum DepositStatus {
  PENDING
  APPROVED
  REJECTED
}

model Deposit {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation("DepositsMade", fields: [userId], references: [id], onDelete: Cascade)
  assetCode     CryptoAssetCode
  asset         CryptoAsset     @relation(fields: [assetCode], references: [code])
  amount        Decimal         @db.Decimal(12, 2)
  addressShown  String
  status        DepositStatus   @default(PENDING)
  transactionId String          @unique
  transaction   Transaction     @relation(fields: [transactionId], references: [id])
  reviewedById  String?
  reviewedBy    User?           @relation("DepositsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Set only when this deposit is the referrer's training-funding payment
  // for a specific Referral (see deposit.service.ts's createDepositRequest/
  // approveDeposit) — reuses the normal deposit/approval flow instead of a
  // separate payment mechanism. Approving this deposit is what marks the
  // referral's trainingFundedAt, nothing else does.
  trainingFundingReferralId String?
  trainingFundingReferral   Referral? @relation("TrainingFundingDeposits", fields: [trainingFundingReferralId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status])
  @@index([trainingFundingReferralId])
}

model Referral {
  id             String         @id @default(uuid())
  referrerId     String
  referredUserId String         @unique
  status         ReferralStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  referredUser   User           @relation("ReferralReceived", fields: [referredUserId], references: [id], onDelete: Cascade)
  referrer       User           @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)

  // Training-funding gate (see trainingTask.service.ts's training-access
  // check): the referrer must provide this amount, confirmed by an admin,
  // before the referred user's training unlocks. Nullable/unset for every
  // referral row created before this feature and for referrals never used
  // to unlock training. trainingFundingTxId points at the real Transaction
  // (on the referrer's own account) recording that funding — see
  // admin.service.ts's confirmTrainingFunding.
  trainingFundingRequired Decimal?  @db.Decimal(12, 2)
  trainingFundedAt        DateTime?
  trainingFundingTxId     String?
  fundingDeposits         Deposit[] @relation("TrainingFundingDeposits")

  @@index([referrerId])
}

enum Role {
  ADMIN
  USER
}

// Mirrors the exact tier thresholds in utils/tiers.ts (backend) and
// src/utils/tiers.ts (frontend) — used only for User.manualTier, the
// admin-granted override. The tier a customer sees/has is never stored
// directly otherwise; it's computed from completedOrders/totalDeposits.
enum Tier {
  Bronze
  Silver
  Gold
  Platinum
}

enum TransactionType {
  TASK_REWARD
  DEPOSIT
  WITHDRAW
  ADMIN_CREDIT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ReferralStatus {
  PENDING
  ACTIVE
}

// Singleton row (application-enforced: services always get-or-create the
// first row rather than relying on a fixed id) holding support-channel
// configuration. Started with just the Telegram contact; a natural home for
// other admin-configurable support settings later.
model SupportSettings {
  id                String   @id @default(uuid())
  telegramUsername  String?
  telegramEnabled   Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// DEPRECATED (kept in place, unused): admin-managed training courses.
// Structure is deliberately flat: Course -> Chapters -> Lessons, plus one
// Assessment (with Questions/Answers) per course. No modules/units/nested
// sections beyond this.
//
// Superseded by TrainingTask / TrainingTaskSubmission below — the simple
// product-image-identification training system. These models and their
// tables are left in place on purpose (not dropped) because the migration
// that created them is already applied to a live database and nothing here
// currently writes to them; dropping is a separate, deliberate decision for
// later, not a side effect of this change. Nothing in the app routes to
// these anymore.
//
// trainingCompletedAt (on User) was the single source of truth the deposit
// gate checks — it is never set directly by a client request. It was only
// ever set by evaluateAndSetTrainingCompletion() in training.service.ts, as
// a side effect of the backend scoring a passed assessment attempt for every
// published+required course. That function is untouched and still callable,
// but nothing in the current app calls it anymore — see
// trainingTaskCompletion.service.ts for the function that now writes
// trainingCompletedAt in practice.
// ---------------------------------------------------------------------------

model TrainingCourse {
  id           String   @id @default(uuid())
  title        String
  slug         String   @unique
  description  String?
  thumbnailUrl String?
  isPublished  Boolean  @default(false)
  isRequired   Boolean  @default(false)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  chapters   TrainingChapter[]
  assessment TrainingAssessment?
  progress   UserTrainingProgress[]

  @@index([isPublished])
}

model TrainingChapter {
  id          String   @id @default(uuid())
  courseId    String
  course      TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons TrainingLesson[]

  @@index([courseId])
}

model TrainingLesson {
  id          String   @id @default(uuid())
  chapterId   String
  chapter     TrainingChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  title       String
  content     String
  videoUrl    String?
  order       Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  completions UserLessonCompletion[]

  @@index([chapterId])
}

model TrainingAssessment {
  id           String   @id @default(uuid())
  courseId     String   @unique
  course       TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title        String
  passingScore Int      @default(70)
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  questions TrainingQuestion[]
}

model TrainingQuestion {
  id           String   @id @default(uuid())
  assessmentId String
  assessment   TrainingAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question     String
  order        Int      @default(0)
  points       Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  answers TrainingAnswer[]

  @@index([assessmentId])
}

model TrainingAnswer {
  id         String   @id @default(uuid())
  questionId String
  question   TrainingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer     String
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)

  @@index([questionId])
}

// One row per user per course: latest assessment outcome. Attempts may be
// retaken (no attempt-history table by design — keeps this minimal); each
// submission overwrites score/passed and increments attempts.
model UserTrainingProgress {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  score       Int?
  passed      Boolean  @default(false)
  attempts    Int      @default(0)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([courseId])
}

// Which lessons a user has marked complete — drives the chapter/lesson
// progress UI and the "required lessons completed" part of the completion
// rule. Editing a lesson's content/title/order never touches this table, so
// existing progress survives ordinary content edits.
model UserLessonCompletion {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      TrainingLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([userId, lessonId])
}

// ---------------------------------------------------------------------------
// Product-image identification training — the simple replacement for the
// course/chapter/lesson/assessment system above. Admin uploads a product
// photo and types the product name (which doubles as the label admins see
// and the exact answer customers must type — there is deliberately no
// separate "expected answer" field, since the admin form never exposes one).
// Customer looks at the photo and types the product name; every submission
// is reviewed by an admin (PENDING -> APPROVED/REJECTED) — an admin's
// approval is what counts toward completion, never the raw text match by
// itself (isAutoMatch is only a triage hint shown to the admin).
//
// trainingCompletedAt (on User) is set here by
// evaluateAndSetTaskTrainingCompletion() in trainingTaskCompletion.service.ts
// once every published+required TrainingTask has at least one APPROVED
// submission from the user — a second, independent writer of the same field
// alongside the legacy evaluateAndSetTrainingCompletion() above.
// ---------------------------------------------------------------------------

enum TrainingTaskSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model TrainingTask {
  id          String   @id @default(uuid())
  productName String
  imageUrl    String
  instruction String
  isPublished Boolean  @default(false)
  isRequired  Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  submissions TrainingTaskSubmission[]

  @@index([isPublished])
}

// Snapshotting productName/imageUrl at submission time means an admin
// editing or replacing a task later never silently rewrites the meaning of
// a historical submission (see TrainingTask doc comment above). taskId is
// nullable and onDelete: SetNull (rather than Cascade) for the same
// reason: deleting a TrainingTask must never delete the historical review
// record of what was submitted, by whom, and how it was reviewed — only
// the now-dangling reference to the deleted task itself is cleared.
model TrainingTaskSubmission {
  id                  String                       @id @default(uuid())
  userId              String
  user                User                         @relation("TrainingTaskSubmissionsByUser", fields: [userId], references: [id], onDelete: Cascade)
  taskId              String?
  task                TrainingTask?                @relation(fields: [taskId], references: [id], onDelete: SetNull)
  submittedAnswer     String
  isAutoMatch         Boolean                      @default(false)
  productNameSnapshot String
  imageUrlSnapshot    String
  status              TrainingTaskSubmissionStatus @default(PENDING)
  reviewedById        String?
  reviewedBy          User?                        @relation("TrainingTaskSubmissionsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt          DateTime?
  rejectionReason     String?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  @@index([userId])
  @@index([taskId])
  @@index([status])
}
