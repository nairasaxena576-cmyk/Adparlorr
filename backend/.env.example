# Copy this file to .env and fill in real values locally. Never commit .env.
#
# --- Render (production) notes ---
# Set these as Render environment variables on the backend service, not in a
# committed file. Render injects PORT itself — do not set PORT manually there.
#   NODE_ENV=production
#   COOKIE_SECURE=true
#   COOKIE_SAME_SITE=none   (frontend on Netlify, backend on Render — different
#                             sites, so the auth cookie needs SameSite=None;
#                             requires COOKIE_SECURE=true, which Render's HTTPS
#                             already satisfies)
#   CORS_ORIGIN=https://YOUR-NETLIFY-SITE.netlify.app   (never "*")
#   JWT_SECRET=<a real generated secret — see below; never a placeholder>
NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/adparlorr_training

# Separate database for the test suite (which truncates tables between tests).
# If unset, it defaults to "<DATABASE_URL's db name>_test". The test setup
# refuses to run unless this URL's database name contains "test", as a guard
# against accidentally truncating a real dev/prod database.
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/adparlorr_training_test

# --- JWT signing (dedicated secret, NOT reused for anything else) ---
# Generate a strong random value, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required in every environment; in production it is additionally rejected if
# it looks like a placeholder (e.g. contains "changeme", "example", "your-secret").
JWT_SECRET=
JWT_EXPIRES_IN=1d

# --- Cookie behavior (non-secret configuration; no signing secret needed here — see README) ---
# Local dev (same-origin-ish, http): COOKIE_SECURE=false, COOKIE_SAME_SITE=lax
# Production (Netlify frontend, Render backend — cross-site, https only):
#   COOKIE_SECURE=true, COOKIE_SAME_SITE=none
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# CORS — the deployed frontend origin. Must be one explicit origin, never "*".
# Local dev: http://localhost:5173
# Production: https://YOUR-NETLIFY-SITE.netlify.app
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# Seed-only admin bootstrap credentials (read once by prisma/seed.ts; never hardcoded in source)
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Training-simulation configuration (all simulated — no real financial meaning)
SIMULATION_MERGE_THRESHOLD=15
SIMULATION_MIN_WITHDRAWAL_BALANCE=100
SIMULATION_MAX_DEPOSIT_AMOUNT=100000
# Fixed size of one customer workbench set — always exactly 45 slots.
SIMULATION_WORKBENCH_SET_SIZE=45

# --- Supabase Storage (training task product images) ---
# BACKEND-ONLY SECRETS. SUPABASE_SERVICE_ROLE_KEY must never be exposed to
# the frontend, never prefixed VITE_*, never returned in an API response,
# and never logged. Create the bucket named below in your Supabase
# project's Storage dashboard before uploading any training task images —
# see backend/README.md for exact setup steps. Optional locally (falls back
# to a clear runtime error only when someone actually tries to upload an
# image without these set) but required in production.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=training-task-images
